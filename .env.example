# Copy this file to `.env` and fill in your keys, then restart `npm run dev`.
# Vite only reads .env at startup, so a restart is required after any change.
#
# Both alerts are optional and independent. Without them the site still works and
# still records every enquiry in the admin portal — you just are not notified.

# ── Email alerts (EmailJS) ──────────────────────────────────────────────────
# Sends every enquiry and booking to vrstores.airconditioner@gmail.com.
# Sign up free at https://emailjs.com (200 emails/month), then:
#   1. Email Services → add a service, connect the store's Gmail  → Service ID
#   2. Email Templates → create a template (see README for the body) → Template ID
#   3. Account → General → Public Key
# All three are required; leave any blank and email alerts stay switched off.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── WhatsApp alerts (CallMeBot) ─────────────────────────────────────────────
# Sends a short WhatsApp to the store's number. Setup, from the phone that owns
# the number below:
#   1. Save +34 644 51 95 23 as a contact (CallMeBot).
#   2. WhatsApp it the exact message:  I allow callmebot to send me messages
#   3. It replies with your API key. Paste it here.
# Note: CallMeBot is a free unofficial service with no guarantee, and the browser
# cannot confirm delivery (see src/data/notify.js). Treat email as the reliable
# channel and WhatsApp as the nudge.
VITE_CALLMEBOT_APIKEY=

# The number that authorised CallMeBot above, with country code.
# Defaults to the store's number if left blank.
VITE_CALLMEBOT_PHONE=+919940291467

# ── Invoice generator database (Supabase) ──────────────────────────────────
# The GST invoice generator (Admin → Invoice Generator) stores customers,
# documents and stock here. Without these it still works, but saves to one
# browser only — invoices raised on the shop PC will not appear on your phone.
# Find both in your Supabase project under Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
